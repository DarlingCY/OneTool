{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneTool",
  "version": "0.0.6",
  "identifier": "com.onetool.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OneTool",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDRTdDNEJBQzYwODZDQTEKUldTaGJBakd1c1RuckthWlk2ZXpLcEJ5ZmtHcmtNK3BXV2JyRVUxYjdTS2VuRE1KZEk0YTlBemgK",
      "endpoints": [
        "https://github.com/DarlingCY/OneTool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
